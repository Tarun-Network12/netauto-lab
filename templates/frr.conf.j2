frr defaults traditional
hostname {{ hostname }}
service integrated-vtysh-config
!
interface lo
 ip address {{ loopback }}
!
{% for intf in interfaces %}
interface {{ intf.name }}
 ip address {{ intf.ip }}
{% if intf.ospf_cost is defined %}
 ip ospf cost {{ intf.ospf_cost }}
{% endif %}
!
{% endfor %}
router ospf
 ospf router-id {{ router_id }}
 network {{ loopback | network }} area {{ ospf_area }}
{% for intf in interfaces %}
 network {{ intf.ip | network }} area {{ ospf_area }}
{% endfor %}
!
line vty
!
